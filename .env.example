# Public browser configuration (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Legacy projects may use this name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secrets: never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=notifications@example.com

# Optional end-to-end test target. Leave unset to run against local Next.js dev server.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
