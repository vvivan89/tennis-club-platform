# Copy this file to .env.local and replace the placeholders. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public origin used in emailed links and payment return URLs (no trailing path).
NEXT_PUBLIC_SITE_URL=https://your-club-domain.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PCTC_DEMO_PASSWORD=replace-with-a-unique-demo-password
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=
CRON_SECRET=replace-with-a-long-random-secret
RESEND_FROM_EMAIL=notifications@your-verified-domain.example
# Generate once with `pnpm exec web-push generate-vapid-keys --json`; keep private key server-only.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@your-club-domain.example
