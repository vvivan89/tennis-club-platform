{
  "name": "pctc-club-platform",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "clean:demo": "node scripts/clean-demo-data.mjs",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,css,md}\" \"components/**/*.{js,jsx,ts,tsx,css,md}\" \"lib/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,jsx,ts,tsx}\" \"*.{js,mjs,json,md,ts}\" \".github/**/*.{yml,yaml}\" \"supabase/**/*.md\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,ts,tsx,css,md}\" \"components/**/*.{js,jsx,ts,tsx,css,md}\" \"lib/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,jsx,ts,tsx}\" \"*.{js,mjs,json,md,ts}\" \".github/**/*.{yml,yaml}\" \"supabase/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "security:audit": "npm audit --audit-level=high",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:migrations && pnpm check:rls && pnpm test && pnpm build",
    "quality:full": "pnpm quality && pnpm test:e2e",
    "check:rls": "node scripts/check-rls.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
